<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright the quai contributors -->
<component type="desktop-application">
  <id>io.github.it_yohan.Quai</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <name translate="no">Quai</name>
  <summary>Keep GitHub release RPMs up to date</summary>
  <developer id="io.github.it_yohan">
    <name translate="no">The quai contributors</name>
  </developer>

  <description>
    <p>
      Many applications publish their Fedora packages only as .rpm files attached to
      releases on GitHub, GitLab or Codeberg. Installed by hand, those packages never
      receive updates.
    </p>
    <p>
      Quai follows these projects for you. Each one becomes a small signed repository
      served on your own computer, so new releases arrive like any other update, in
      Software, Discover or dnf, and can be rolled back the same way.
    </p>
    <ul>
      <li>Add a project by typing owner/repo or pasting its address</li>
      <li>See which packages it ships, and anything worth knowing, before adding it</li>
      <li>Get the build made for your Fedora release when a project ships several</li>
      <li>Packages that would replace system ones are held back until you allow them</li>
      <li>Metadata signed with a key that never leaves your computer</li>
      <li>Works on Fedora Workstation, KDE Plasma and the Atomic desktops</li>
    </ul>
    <p>
      Quai looks at home on both main Fedora desktops: GTK and libadwaita on GNOME,
      Kirigami on KDE Plasma. Everything is also available from the quai command.
    </p>
  </description>

  <launchable type="desktop-id">io.github.it_yohan.Quai.desktop</launchable>
  <translation type="gettext">quai</translation>

  <url type="homepage">https://github.com/IT-Yohan/quai</url>
  <url type="bugtracker">https://github.com/IT-Yohan/quai/issues</url>
  <url type="vcs-browser">https://github.com/IT-Yohan/quai</url>
  <url type="help">https://github.com/IT-Yohan/quai#use-it</url>
  <url type="translate">https://github.com/IT-Yohan/quai#languages</url>

  <branding>
    <color type="primary" scheme_preference="light">#f9f06b</color>
    <color type="primary" scheme_preference="dark">#1a3a5c</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <provides>
    <binary>quai</binary>
  </provides>

  <keywords>
    <keyword translate="no">rpm</keyword>
    <keyword translate="no">dnf</keyword>
    <keyword translate="no">GitHub</keyword>
    <keyword translate="no">GitLab</keyword>
    <keyword translate="no">Codeberg</keyword>
    <keyword>release</keyword>
    <keyword>update</keyword>
    <keyword>repository</keyword>
    <keyword>package</keyword>
  </keywords>

  <screenshots>
