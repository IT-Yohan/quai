      <caption>Followed projects, and what is waiting to be updated</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/gnome-sources.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>A project's packages and settings</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/gnome-source.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Adding a project after seeing what it ships</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/gnome-add.png</image>
    </screenshot>
    <screenshot environment="plasma">
      <caption>The same window on KDE Plasma</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/plasma-sources.png</image>
    </screenshot>
    <screenshot environment="plasma">
      <caption>A project's page on KDE Plasma</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/plasma-source.png</image>
    </screenshot>
    <screenshot environment="gnome:dark">
      <caption>In the dark style</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/gnome-sources-dark.png</image>
    </screenshot>
    <screenshot environment="plasma">
      <caption>With Breeze Dark</caption>
      <image type="source" width="1800" height="1240">https://raw.githubusercontent.com/IT-Yohan/quai/v@VERSION@/data/screenshots/plasma-sources-dark.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-11-19">
      <url type="details">https://github.com/IT-Yohan/quai/releases/tag/v0.1.0</url>
      <description>
        <p>First release of Quai.</p>
        <ul>
          <li>Follow GitHub, GitLab and Forgejo or Codeberg projects that publish RPM packages in their releases</li>
          <li>Updates through dnf, GNOME Software, Discover and rpm-ostree, from signed metadata served on your computer</li>
          <li>The build made for your Fedora release is chosen automatically, and follows system upgrades</li>
          <li>Native windows for GNOME and KDE Plasma, and the quai command with man pages and completions</li>
          <li>Available in English and French</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
