[Unit]
Description=quai local repository gateway
Documentation=https://github.com/IT-Yohan/quai
Requires=quaid.socket
After=quaid.socket

[Service]
Type=exec
ExecStart=/usr/libexec/quaid
# Started on the first connection from dnf, exits after 2 minutes of inactivity
# (daemon.idle_timeout_secs in /etc/quai/quai.toml).
User=quai
Group=quai
CacheDirectory=quai
CacheDirectoryMode=0755
UMask=0022

# A corporate proxy goes in a drop-in (`systemctl edit quaid.service`):
#   [Service]
#   Environment=HTTPS_PROXY=http://proxy.example.com:3128

# Hardening: with ProtectSystem=strict, quaid can only write its cache directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
